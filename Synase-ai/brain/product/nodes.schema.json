{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synase Product Brain Node",
  "type": "object",
  "required": ["id", "type", "projectId", "provenance"],
  "properties": {
    "id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["project", "requirement", "product_feature", "product_strategy", "roadmap_item", "evidence", "product_decision", "product_risk", "release", "dependency"]
    },
    "projectId": { "type": "string" },
    "provenance": { "type": "string", "enum": ["confirmed", "ai_suggested"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
